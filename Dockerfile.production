# Optimized Multi-stage Dockerfile for DATect
# Uses UV (10x faster installs) and Granian (20-40% faster server)

# ============================================
# Stage 1: Python dependencies builder
# ============================================
# Python 3.10: the Hyak Spark env that builds the precomputed store (config hash includes it)
FROM python:3.10-slim AS python-builder

WORKDIR /build

# Install UV package manager (10x faster than pip)
RUN pip install uv

# Copy and install Python dependencies; the model libraries are pinned to the
# versions the precomputed store was built with (its config hash includes them)
COPY requirements.txt constraints.txt ./
RUN uv pip install --system --no-cache -r requirements.txt -c constraints.txt

# ============================================
# Stage 2: Frontend builder
# ============================================
FROM node:22-slim AS frontend-builder

WORKDIR /frontend

# Copy package files and install exactly what the lockfile records
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

# Copy frontend source and build
COPY frontend/ ./
RUN NODE_OPTIONS="--max_old_space_size=4096" npm run build

# ============================================
# Stage 3: Production image
# ============================================
FROM python:3.10-slim AS production

LABEL maintainer="DATect Team"
LABEL description="DATect - Domoic Acid Forecasting System (Optimized Production)"

WORKDIR /app

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder
COPY --from=python-builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin

# Copy application code
COPY backend ./backend
COPY forecasting ./forecasting
COPY data ./data
COPY config ./config
COPY config.py .
# Evaluation results behind /api/metrics/summary (headline metrics shown on the dashboard)
COPY results/chronological ./results/chronological
COPY results/multi_seed ./results/multi_seed

# Precomputed store: Delta tables built on Spark (datect_spark/store.sbatch), served
# when their config hash matches this image's; anything else is computed on demand
COPY store ./store

# Copy built frontend
COPY --from=frontend-builder /frontend/dist ./frontend/dist

# Verify setup. A deployed store must be complete and current for this image (same
# code, config, data and library versions), or every retrospective would be recomputed
# on Cloud Run, which takes minutes; REQUIRE_CURRENT_STORE=0 only for CI's stub store.
ARG REQUIRE_CURRENT_STORE=1
RUN ls -la ./store/ && \
    ls -la ./frontend/dist/ && \
    python -c "import fastapi, granian, deltalake, config; print('Dependencies and config OK')" && \
    if [ "$REQUIRE_CURRENT_STORE" = "1" ]; then python -m backend.precomputed check ./store; fi && \
    echo "✅ Build verification complete"

# Create non-root user for security
RUN groupadd -r datect && useradd -r -g datect datect && \
    chown -R datect:datect /app && \
    chmod -R 555 ./store

USER datect

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8080/health', timeout=5)"

# Expose port
EXPOSE 8080

# Environment variables
ENV PORT=8080
ENV PYTHONPATH=/app
ENV DATECT_PRECOMPUTED_DIR=/app/store
ENV DATECT_USE_GRANIAN=1

# Serve with Granian (Rust-based ASGI server); set DATECT_USE_GRANIAN=0 for Uvicorn.
# exec + no stderr redirection, so startup errors reach the container logs.
CMD ["sh", "-c", "if [ \"$DATECT_USE_GRANIAN\" = \"1\" ]; then exec granian --interface asgi backend.api:app --host 0.0.0.0 --port \"$PORT\"; else exec python -m uvicorn backend.api:app --host 0.0.0.0 --port \"$PORT\"; fi"]
