# Upload whitelist for `gcloud builds submit`: only the Docker build inputs.
# (Mirrors .dockerignore; .gitignore is intentionally not included because the
# precomputed store/ directory must be uploaded.)
/*
!/backend/
!/forecasting/
!/data/
!/config/
!/config.py
!/results/
!/requirements.txt
!/store/
!/constraints.txt
!/frontend/
!/Dockerfile.production
!/.dockerignore

frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.DS_Store
