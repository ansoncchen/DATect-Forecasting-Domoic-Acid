# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Logs (evaluation logs that back a reported number are committed as .txt)
*.log
# logs/ is kept in git: Slurm opens --output=logs/... before a job can mkdir it
logs/*
!logs/.gitkeep
outputs/logs/
.claudeignore
.cursorignore

# Data files (keep structure but not data)
data/raw/*/*.parquet
data/intermediate/
raw_validation_plots/

# ML training artifacts
catboost_info/
*.nc
**/study.db

# Node.js (frontend)
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json is tracked — needed for reproducible installs and CI cache

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.venv
.claude/
.cursor/

# AI agent config files
.ralph/
.ralphrc

# Pre-computed caches (generated on Hyak, too large for git)
cache/
cache_seed123/

# Evaluation outputs: results/ is tracked (it backs the reported numbers);
# regenerable retrospective caches and scratch runs are not.
results/**/retro*/
results/**/_cache/
results/**/*.png
results/env_lead/prespike_features.csv
eval_results/
golden_multi_seed/
golden-*.out
golden-*.err

# OAD generated figures (paper copies live under papers/*/figures)
oad/outputs/figures_*/

# LaTeX build artifacts (sources, figures, class files and PDFs are tracked)
**/_temp_compile.*
**/*.aux
**/*.bbl
**/*.blg
**/*.fdb_latexmk
**/*.fls
**/*.out
**/*.synctex.gz
**/*.toc

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*\ 2.py
*\ copy.py
