# Upload whitelist for `gcloud builds submit`: only the Docker build inputs.
# (Mirrors .dockerignore; .gitignore is intentionally not included because the
# pre-computed cache/ directory must be uploaded.)
/*
!/backend/
!/forecasting/
!/data/
!/config/
!/config.py
!/requirements.txt
!/cache/
!/frontend/
!/Dockerfile.production
!/.dockerignore

frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.DS_Store
