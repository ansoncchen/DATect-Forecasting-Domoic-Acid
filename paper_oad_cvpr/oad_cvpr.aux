\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Study region (41--49\textdegree \,N) with example MODIS Aqua 8-day composite. The U.S.\ PNW coastal box is analyzed at 0.025\textdegree \ resolution on a 321$\times $409 grid. Five alongshore sub-regions are used for downstream analysis; the Olympic Coast region contains the NEMO mooring (47.97\textdegree \,N, 124.97\textdegree \,W) at which ESP in-situ measurements were collected during the 2016--2018 ChaBa deployments.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:study-region}{{1}{2}{Study region (41--49\textdegree \,N) with example MODIS Aqua 8-day composite. The U.S.\ PNW coastal box is analyzed at 0.025\textdegree \ resolution on a 321$\times $409 grid. Five alongshore sub-regions are used for downstream analysis; the Olympic Coast region contains the NEMO mooring (47.97\textdegree \,N, 124.97\textdegree \,W) at which ESP in-situ measurements were collected during the 2016--2018 ChaBa deployments}{figure.caption.1}{}}
