\citation{Hickey2010}
\citation{Bond2015}
\citation{McCabe2016,McCabe2023}
\citation{Jacox2018}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Held-out 7-day-ahead forecast skill ($R^2$), by region (2019+).} Each method predicts the next week's regional anomaly state from the past 4 days, and bars above zero do better than just guessing the mean. OAD (purple, the 70\%-mask variant) is positive in all five regions (0.10--0.26), which is not a huge number, but every other method we tried sits at or below zero. PCA (gray) is the right control because it has the same number of dimensions as the autoencoder, so the gap is not just ``more parameters help.'' Day-of-year climatology (light gray) is worse than the mean. The lower-masking OAD-50 variant is positive in only 3 of 5 regions, since it trades multi-step skill for a slightly cleaner cloud-cover signature (\cref  {sec:cloud}), which is why we report and ship mae070 rather than mae050.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:forecastability}{{3}{4}{\textbf {Held-out 7-day-ahead forecast skill ($R^2$), by region (2019+).} Each method predicts the next week's regional anomaly state from the past 4 days, and bars above zero do better than just guessing the mean. OAD (purple, the 70\%-mask variant) is positive in all five regions (0.10--0.26), which is not a huge number, but every other method we tried sits at or below zero. PCA (gray) is the right control because it has the same number of dimensions as the autoencoder, so the gap is not just ``more parameters help.'' Day-of-year climatology (light gray) is worse than the mean. The lower-masking OAD-50 variant is positive in only 3 of 5 regions, since it trades multi-step skill for a slightly cleaner cloud-cover signature (\cref {sec:cloud}), which is why we report and ship mae070 rather than mae050}{figure.caption.4}{}}
\newlabel{fig:forecastability@cref}{{[figure][3][]3}{[1][3][]4}{}{}{}}
\@writefile{brf}{\backcite{Moore2021ESP}{{4}{4.2}{subsection.4.2}}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces OAD score for the Olympic Coast region (which contains NEMO) vs.\ the in-situ ESP measurements taken at NEMO, 2016--2018 (\textit  {Pn} cells by SHA assay; pDA by cELISA). Pearson is on raw values; Spearman is the rank correlation, robust to the heavy-tailed bloom-spike days. Brackets are 95\% bootstrap CIs (2{,}000 resamples, seed = 42). The cell-density signal survives the rank test; the toxin signal does not.}}{4}{table.caption.5}\protected@file@percent }
\newlabel{tab:esp}{{2}{4}{OAD score for the Olympic Coast region (which contains NEMO) vs.\ the in-situ ESP measurements taken at NEMO, 2016--2018 (\textit {Pn} cells by SHA assay; pDA by cELISA). Pearson is on raw values; Spearman is the rank correlation, robust to the heavy-tailed bloom-spike days. Brackets are 95\% bootstrap CIs (2{,}000 resamples, seed = 42). The cell-density signal survives the rank test; the toxin signal does not}{table.caption.5}{}}
\newlabel{tab:esp@cref}{{[table][2][]2}{[1][4][]4}{}{}{}}
