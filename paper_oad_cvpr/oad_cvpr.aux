\@writefile{brf}{\backcite{He2022MAE}{{2}{3}{figure.caption.2}}}
\citation{Moore2021ESP}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces OAD pipeline. Input is a 4-channel ($C{=}4$), 4-day-window ($T{=}4$), 64$\times $64 patch tiled over the 321$\times $409 grid. The encoder applies three stride-2 3D conv blocks to a latent of dimension 32, and the decoder symmetrically reconstructs the input. During Phase~C training, 70\% of input pixels are randomly masked and the masked-MSE reconstruction loss is computed only on ocean pixels (cloud-flagged NaNs excluded per-pixel). The anomaly score is the anchor-frame reconstruction error, averaged over each region's ocean pixels and z-scored against history.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:architecture}{{2}{3}{OAD pipeline. Input is a 4-channel ($C{=}4$), 4-day-window ($T{=}4$), 64$\times $64 patch tiled over the 321$\times $409 grid. The encoder applies three stride-2 3D conv blocks to a latent of dimension 32, and the decoder symmetrically reconstructs the input. During Phase~C training, 70\% of input pixels are randomly masked and the masked-MSE reconstruction loss is computed only on ocean pixels (cloud-flagged NaNs excluded per-pixel). The anomaly score is the anchor-frame reconstruction error, averaged over each region's ocean pixels and z-scored against history}{figure.caption.2}{}}
\newlabel{fig:architecture@cref}{{[figure][2][]2}{[1][2][]3}{}{}{}}
